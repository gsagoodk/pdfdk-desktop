{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF.dk Desktop",
  "version": "0.4.6",
  "identifier": "dk.pdf.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "PDF.dk Desktop",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://pdf.dk https://*.pdf.dk https://api.github.com https://github.com https://objects.githubusercontent.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "description": "PDF document",
        "role": "Viewer"
      },
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "webp",
          "gif",
          "bmp",
          "tif",
          "tiff"
        ],
        "description": "Image",
        "role": "Viewer"
      },
      {
        "ext": [
          "heic",
          "heif"
        ],
        "description": "HEIC image",
        "role": "Viewer"
      },
      {
        "ext": [
          "svg",
          "eps",
          "ai"
        ],
        "description": "Vector artwork",
        "role": "Viewer"
      },
      {
        "ext": [
          "stl",
          "step",
          "stp"
        ],
        "description": "3D model",
        "role": "Viewer"
      },
      {
        "ext": [
          "eml",
          "msg"
        ],
        "description": "Email",
        "role": "Viewer"
      },
      {
        "ext": [
          "ppt",
          "pptx"
        ],
        "description": "Presentation",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": [
          "Danish",
          "English"
        ],
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "Danish": "./nsis/Danish.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDQzE1NkMxN0ZFQ0IwNEMKUldSTXNPeC93VmJCSEpvUFBPeTJENWRYM0MxVHFnQzBsbjlLek1pWkVzSnBXMFdKTnBBVWcvN1gK",
      "endpoints": [
        "https://github.com/GSredhill/pdfdk-desktop/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "pdfdk"
        ]
      }
    }
  }
}
